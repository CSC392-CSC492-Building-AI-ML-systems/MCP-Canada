# Export these variables in your shell; Django does not load this file automatically.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Required when DJANGO_DEBUG=false:
# DJANGO_SECRET_KEY=replace-with-a-random-secret

# Optional absolute SQLite database path (default: backend/db.sqlite3):
# DJANGO_DB_PATH=/absolute/path/to/explorer.sqlite3

# MCP-Canada data server (separate project), used by /api/mcp-canada/... endpoints.
# Django starts it on the first request; the rest of the app runs without these.
# Install it once first:
#   uv tool run --from git+https://github.com/CSC392-CSC492-Building-AI-ML-systems/mcp-canada-server mcp-canada --help
MCP_CANADA_COMMAND=uv
MCP_CANADA_ARGS="tool run --from git+https://github.com/CSC392-CSC492-Building-AI-ML-systems/mcp-canada-server mcp-canada"
# Optional working directory for the server process:
# MCP_CANADA_CWD=/absolute/path
# Optional seconds to wait for the server to start or for one call (default 20):
# MCP_CANADA_TIMEOUT=20
